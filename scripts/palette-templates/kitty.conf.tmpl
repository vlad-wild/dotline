# Generated by scripts/palette-post — do not edit, edit the templates instead.
# Included from dotfiles/kitty/.config/kitty/kitty.conf via `include theme-dotline.conf`,
# AFTER kitty.conf's own static color0..color15, so this only overrides the
# surfaces and the two accent slots — the rest of the 16-colour ANSI scheme
# (used by git diff, ls, syntax highlighting) stays legible and untouched.

background @@surface@@
foreground @@on@@

cursor            @@on@@
cursor_text_color @@surface@@

selection_background @@surfaceHigh@@
selection_foreground @@on@@

url_color @@accent@@

active_border_color   @@accent@@
inactive_border_color @@outline@@

# ANSI red / bright red: ties errors and the red parts of a diff to the same
# accent the rest of the desktop takes from the wallpaper.
color1 @@accent@@
color9 @@accent@@

# Bright black (dim text, line numbers, comments) follows the palette too.
color8 @@muted@@
