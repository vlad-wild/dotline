// dotline — niri config.kdl
//
// Requires niri ≥ 26.04 (this `include` node, and ext-background-effect
// blur used later by Quickshell). Check with: niri --version
//
// Colours live in colors.kdl, regenerated by scripts/palette-post whenever
// the wallpaper changes (see the layout block below) — this file only has
// the parts that don't change with the wallpaper.
//
// Verify after editing: niri validate -c ~/.config/niri/config.kdl
// (also run automatically by update.sh's check_configs).

// ---------- output ----------
// Zenbook 14 UX3405CA panel. The connector name is usually eDP-1 but is not
// guaranteed — check `niri msg outputs` on first login and fix this block
// if it's named differently. Per-monitor-set profiles (external displays,
// the eGPU desk setup) are a later step (Displays.qml); this is just the
// laptop-alone default.
output "eDP-1" {
    mode "2880x1800@120"
    scale 2.0
}

// ---------- input ----------
input {
    keyboard {
        xkb {
            layout "us,ru"
            options "grp:win_space_toggle,ctrl:nocaps"
        }
    }
    touchpad {
        tap
        natural-scroll
        dwt
        click-method "clickfinger"
        accel-profile "adaptive"
    }
    mouse {
        accel-profile "flat"
    }
    // Fn+F on the Zenbook toggles a performance OSD in a later step
    // (Power.qml); no input binding needed for it here.
}

// ---------- layout ----------
layout {
    gaps 16
    center-focused-column "never"
    default-column-width {
        proportion 0.5
    }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    // Border/focus-ring/insert-hint colours — regenerated from the
    // wallpaper. This is a fragment, not a standalone config: it must NOT
    // define its own `layout { }` wrapper (see the comment in that file).
    include "colors.kdl"
}

// Unfocused windows dim slightly — independent of the wallpaper palette,
// so it lives here and not in colors.kdl.
window-rule {
    match is-focused=false
    opacity 0.96
}

// Rounded corners on every window, in the Nothing-style circles-and-pills
// language used across the rest of the rice.
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

// Picture-in-picture: float it in the bottom-right corner instead of
// tiling it in. Matched by title only, not app-id — Chromium's PiP
// window ships with no Wayland app-id at all (confirmed real, upstream
// Chromium bug, not a niri limitation), so app-id matching would silently
// never catch it; title is the one thing both Firefox and Chromium set.
// The regex covers both "Picture-in-Picture" (Firefox) and
// "Picture-in-picture"/"Picture in picture" (Chromium) without needing
// to pin down each browser's exact casing/punctuation.
window-rule {
    match title="[Pp]icture.in.[Pp]icture"
    open-floating true
    default-floating-position x=16 y=16 relative-to="bottom-right"
}

// ---------- startup ----------
// Notification daemon, launcher, bar and lock screen (Quickshell) are a
// later step; only what colours/behaviour depend on goes here for now.
spawn-at-startup "gnome-keyring-daemon" "--start" "--components=secrets"
spawn-at-startup "xwayland-satellite"
spawn-at-startup "qs" "-c" "dotline"
// Hidden window: its rules.yaml-driven gesture engine still runs with no
// window shown (see dotfiles/solaar and docs/mouse.md). No system tray
// built yet to show its icon in either way.
spawn-at-startup "solaar" "--window=hide"
// Clipboard history: cliphist just stores what wl-paste watches (confirmed
// exact pipeline from cliphist's own docs) — no daemon of its own.
spawn-at-startup "wl-paste" "--watch" "cliphist" "store"
// KDE Connect's own daemon, not shown anywhere else: it normally starts via
// XDG autostart (/etc/xdg/autostart/org.kde.kdeconnect.daemon.desktop),
// which a plain compositor like niri never runs — see docs/phone.md. Exact
// install path (/usr/bin/kdeconnectd) confirmed from the Arch package's own
// file list, not guessed.
spawn-at-startup "/usr/bin/kdeconnectd"
// "Закрепление" плавающего окна на всех рабочих столах (Mod+Shift+P, see
// binds below) — niri has no native sticky-window concept (confirmed:
// open upstream issue niri-wm/niri#932), this is the small third-party
// daemon the niri community built for exactly this, not something this
// rice reimplements from scratch. AUR package, see packages/desktop.txt.
spawn-at-startup "niri-float-sticky"

// Restore the last wallpaper (and its palette) on login, so a reboot
// doesn't come up with awww's blank default. DOTLINE_ROOT is set by
// whichever checkout install.sh ran from (see docs/install-arch.md); the
// fallback below only fires before dotline-wallpaper has ever been run.
spawn-at-startup "sh" "-c" "dotline-wallpaper set \"$(cat ~/.local/state/dotline/wallpaper 2>/dev/null || echo \"${DOTLINE_ROOT:-$HOME/dev/linux-migrate}/wallpapers/clouds.jpg\")\""

// ---------- switch events (lid) ----------
// niri already turns the internal panel on/off with the lid on its own;
// this just adds locking on top, and only on close. Unlike key binds,
// switch events fire even while the session is already locked (real niri
// behaviour, not a guess) — harmless to call `lock lock` again on an
// already-locked session. Idle-timeout locking (independent of the lid)
// is the Power step's job, not this one.
switch-events {
    lid-close { spawn "qs" "-c" "dotline" "ipc" "call" "lock" "lock"; }
}

// ---------- binds ----------
// Mod = the Super/Windows key. Workspaces are numbered 1-9 like the
// mock-up's dot row; column focus/move is what the mock-up's ←/→ do.
binds {
    Mod+Return { spawn "kitty"; }
    // The launcher is Quickshell's own (see shell.qml's IpcHandler "launcher"),
    // not a separate program — it's what the mock-up's search pill + circle
    // grid actually is. fuzzel stays installed as a plain fallback picker
    // for scripts (dotfiles/fuzzel), just not bound here.
    Mod+D { spawn "qs" "-c" "dotline" "ipc" "call" "launcher" "toggle"; }
    // History picker: fuzzel (not the Quickshell launcher) — confirmed
    // exact pipeline from cliphist's own docs.
    Mod+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }
    Mod+Q { close-window; }
    Mod+Shift+E { quit; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    Mod+Down { focus-workspace-down; }
    Mod+Up   { focus-workspace-up; }
    Mod+Shift+Down { move-column-to-workspace-down; }
    Mod+Shift+Up   { move-column-to-workspace-up; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }

    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }

    Mod+O { toggle-overview; }
    Mod+Tab { focus-window-previous; }
    Mod+Slash { spawn "qs" "-c" "dotline" "ipc" "call" "keys" "toggle"; }
    Mod+Comma { spawn "qs" "-c" "dotline" "ipc" "call" "settings" "toggle"; }

    Mod+Shift+L { spawn "qs" "-c" "dotline" "ipc" "call" "lock" "lock"; }
    Mod+N { spawn "qs" "-c" "dotline" "ipc" "call" "quicksettings" "toggle"; }
    Mod+K { spawn "qs" "-c" "dotline" "ipc" "call" "phone" "toggle"; }
    Mod+Ctrl+C { spawn "qs" "-c" "dotline" "ipc" "call" "caffeine" "toggle"; }
    Mod+Shift+M { spawn "qs" "-c" "dotline" "ipc" "call" "audio" "muteFocused"; }
    Mod+Shift+N { spawn "qs" "-c" "dotline" "ipc" "call" "dnd" "toggle"; }
    Mod+Ctrl+M { spawn "qs" "-c" "dotline" "ipc" "call" "modes" "cycle"; }
    // ASUS Fn+F (performance mode toggle) isn't bound here: its real
    // keysym needs confirming on the actual keyboard (`wev`/`niri msg
    // input` on the laptop) rather than guessed — this is the reliable
    // fallback bind for the same action in the meantime. Moved to
    // Mod+Ctrl+P (matching the plan's original table) from Mod+Shift+P,
    // which an earlier session bound here by mistake — freed up now that
    // Mod+Shift+P has its real, plan-intended job below (pin window).
    Mod+Ctrl+P { spawn "dotline-power" "cycle"; }

    Print { spawn "sh" "-c" "grim -g \"$(slurp)\" - | wl-copy"; }
    Mod+Print { spawn "grim"; }

    // OCR / QR from a selected region (scripts/capture, docs/capture.md).
    Mod+Shift+T { spawn "dotline-capture" "ocr"; }
    Mod+Shift+Q { spawn "dotline-capture" "qr"; }

    // Scratchpad: kitty's own `quick-access-terminal` kitten — wlr
    // layer-shell dropdown, no custom niri app-id/workspace juggling
    // needed (confirmed from kitty's own docs: it's built for exactly
    // this, not something to reimplement). `~/.config/kitty/quick-access-
    // terminal.conf` (dotfiles/kitty) controls the shared look; a second
    // instance-group keeps the notes dropdown's show/hide independent of
    // the plain shell one.
    Mod+grave { spawn "kitten" "quick-access-terminal"; }
    Mod+Shift+grave {
        spawn "sh" "-c" "mkdir -p ~/Notes && kitten quick-access-terminal --instance-group notes -- nvim ~/Notes/scratch.md";
    }

    // Закрепить плавающее окно на всех рабочих столах (niri-float-sticky,
    // see spawn-at-startup above).
    Mod+Shift+P { spawn "niri-float-sticky" "-ipc" "toggle_sticky"; }

    // Обои и тема — уже рабочие скрипты (см. scripts/wallpaper, scripts/theme).
    Mod+Shift+W { spawn "dotline-wallpaper" "next"; }
    Mod+Ctrl+Shift+T { spawn "dotline-theme" "auto"; }

    // dotline-osd both makes the change and tells Quickshell to flash the
    // on-screen dot-level popup (Osd.qml) — niri's own spawn can only do
    // the former, so this goes through the wrapper instead of wpctl/
    // brightnessctl directly.
    XF86AudioRaiseVolume  { spawn "dotline-osd" "volume" "up"; }
    XF86AudioLowerVolume  { spawn "dotline-osd" "volume" "down"; }
    XF86AudioMute         { spawn "dotline-osd" "volume" "mute"; }
    XF86MonBrightnessUp   { spawn "dotline-osd" "brightness" "up"; }
    XF86MonBrightnessDown { spawn "dotline-osd" "brightness" "down"; }
}
